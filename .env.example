# Copy to .env and fill in the values. Names + placeholders only — never
# commit real secrets. This is the full operator catalogue for the repo root
# .env (the deploy/docker/.env.example is the narrower container pass-through
# subset). The local .venv reads this directly; the VPS keeps its own copy at
# /etc/alphalens/env.

# --- LLM providers ---------------------------------------------------------

# OpenRouter — DeepSeek v4 Flash + Pro for the thematic pipeline and the
# research-side llm_scorers (migrated off Gemini per PR-G). Distinct from the
# zen-codereview OpenRouter key, for cost-attribution isolation.
OPENROUTER_API_KEY=

# OpenRouter provider pin (optional). OpenRouter load-balances a single model
# id across many upstream providers and enables fallbacks by default, so two
# byte-identical requests can be served by different backends, different
# weights snapshots and different quantisations. "Same prompt, different
# answer" then looks the same in the logs whether the model was
# non-deterministic or the router simply sent us elsewhere. These four knobs
# are the operator's pin; ALL FOUR UNSET = exactly today's behaviour (no
# `provider` block is sent at all). Read only by from_env(), so they apply to
# every call site that uses the default client.
#
# Two intended shapes:
#   LIVE pipeline  — QUANTIZATIONS=fp8 with fallbacks left ENABLED: removes
#                    the fp4/fp8 serving mixture without making one provider a
#                    single point of failure.
#   REPLAY / measurement — PROVIDER_ORDER=<one slug> with ALLOW_FALLBACKS=0:
#                    a run served by a different backend is worthless as a
#                    measurement, so failing closed is the correct outcome.

# Comma-separated provider slugs, in priority order (e.g. DeepInfra,Together).
# Pinning an order fails CLOSED unless ALLOW_FALLBACKS says otherwise.
# ALPHALENS_OPENROUTER_PROVIDER_ORDER=

# 1 keeps PROVIDER_ORDER a preference instead of a requirement. Only read
# alongside an order. Default unset = fail closed.
# ALPHALENS_OPENROUTER_ALLOW_FALLBACKS=

# Comma-separated weight precisions to allow (e.g. fp8). Note the first-party
# DeepSeek endpoint reports its quantization as "unknown", so an fp8 pin
# excludes it.
# ALPHALENS_OPENROUTER_QUANTIZATIONS=

# Restrict routing to providers that declare support for every parameter the
# request sends (response_format json_object, temperature, max_tokens).
# Without it a provider that lacks response_format stays eligible and silently
# ignores it — the model answers in prose and the call site quietly falls back
# to JSON repair. Defaults ON whenever any other knob above is set; set 0 to
# opt out. Setting it to 1 on its own is also a valid pin.
# ALPHALENS_OPENROUTER_REQUIRE_PARAMETERS=

# --- Data vendors ----------------------------------------------------------

# Alpha Vantage — EARNINGS endpoint (paradigm-14 PEAD backfill + next-earnings
# date in briefs). Free tier 25 req/day, quota is per-key.
ALPHA_VANTAGE_API_KEY=

# Polygon — news firehose + minute bars (press gate, broker-free ladder
# replay). ~$30/mo Starter; quota is per-key.
POLYGON_API_KEY=

# FRED (St. Louis Fed) — macro / VIX series. Stamps market_regime_at_entry in
# the daily thematic build via the canonical FREDClient.
FRED_API_KEY=

# Perplexity — literature_review weekly + monthly scans only (not the thematic
# pipeline).
PERPLEXITY_API_KEY=

# --- Notifications ---------------------------------------------------------

# Telegram bot — brief notifications (backlog item; not yet wired live).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SEC EDGAR -------------------------------------------------------------

# SEC EDGAR contact string (email or URL). Not stored in the live root .env
# today — the canonical SecEdgarClient falls back to a built-in default UA —
# but SEC returns 403 without a contact under load, so set it in production.
SEC_EDGAR_USER_AGENT=

# --- Broker (execution) ----------------------------------------------------
# Saxo Bank OpenAPI, SIM environment ONLY (ADR 0014 — the LIVE gateway is
# structurally unreachable in code; lifting that rail requires its own ADR).
# NOTE: the old SAXO_* keys were purged from /etc/alphalens/env with ADR 0012;
# re-adding on the VPS is an operator runbook step when a VPS consumer appears.

# OAuth (P4) — AppKey/AppSecret of the SIM app registered at developer.saxo
# with Grant Type "Code" (not PKCE). Bootstrapped once via the attended
# `alphalens broker auth`; the rotating token pair persists to the store below
# and an existing store beats a set SAXO_SIM_TOKEN.
SAXO_APP_KEY=
SAXO_APP_SECRET=

# Must BYTE-MATCH the portal registration: hostname `localhost` (Saxo rejects
# 127.0.0.1), port AND path exact. Example: http://localhost:8765/callback
SAXO_AUTH_REDIRECT_URL=

# Optional override of the OAuth token-store file
# (default: ~/.alphalens/saxo_auth/token_store.json — created 0600).
# SAXO_TOKEN_STORE_PATH=

# Order-placement gate: `alphalens broker submit --execute` sends NOTHING
# unless this is 1 (dry-run + precheck stay available without it).
# ALPHALENS_BROKER_ALLOW_ORDERS=1

# 24-hour Developer-Portal SIM token — EXPIRES DAILY; regenerate manually at
# developer.saxo. Read by StaticTokenProvider; used ONLY when no OAuth token
# store exists.
SAXO_SIM_TOKEN=

# Optional: pick one AccountKey when the Saxo profile has several accounts.
# With a single account the broker auto-picks; with several and this unset,
# `alphalens broker account` fails loudly rather than guessing.
# SAXO_ACCOUNT_KEY=

# SAXO_LIVE_TEST=1 (flag, not a secret) opts into the live SIM probe
# `tests/live/test_saxo_live.py` — needs a fresh SAXO_SIM_TOKEN + network.

# --- Broker streaming (dark, SIM-only, pure latency win) --------------------
# The auto-manager can early-wake on a Saxo WebSocket fill push instead of only
# on the ~45s REST poll. It ships DARK: unset -> byte-identical to today's
# poll-only loop. Streaming NEVER places orders and NEVER runs reconcile on its
# own — the stream thread only nudges the main loop to run its NEXT reconcile
# early. A total streaming failure (never started / disconnected / silently
# dead / circuit-broken) degrades to EXACTLY the poll-only behaviour, never
# worse. SIM-only by construction (structural rail; LIVE unreachable in code).
# Requires the OAuth provider (a static 24h token cannot be re-authorized in
# place → streaming refuses to start and runs poll-only). Design memo:
# docs/research/saxo_streaming_design_2026_07_24.md.

# Master gate — 1 turns the dark streaming early-wake ON (default unset = off).
# ALPHALENS_BROKER_STREAMING_ENABLED=1

# Stale-alert threshold (seconds): if no streamed frame arrives for this long,
# the MAIN thread raises a throttled "stream silent — on poll backstop" alert
# and emits the alphalens_broker_manager_stream_last_message_age_seconds gauge.
# Must be <= the 45s
# poll so the alert never lags the already-covered protection, and >= the
# observed ~20-30s heartbeat cadence to avoid false reconnects. Default 45.
# ALPHALENS_BROKER_STREAM_STALE_S=45

# Trailing-edge debounce (seconds): coalesces a burst of fill frames into one
# early wake while GUARANTEEING the last burst member still wakes the loop
# within this window. Default 1.0.
# ALPHALENS_BROKER_STREAM_DEBOUNCE_S=1.0

# SAXO_STREAM_LIVE_TEST=1 (flag, not a secret) opts into the attended SIM
# streaming shape probe `tests/live/test_saxo_stream_live.py` — needs the full
# OAuth env + a live token store; asserts protocol SHAPE only, places nothing.

# --- RESEARCH-ONLY / optional ----------------------------------------------
# Keys consumed only by ad-hoc research scripts or expired subscriptions. Safe
# to leave blank for the live thematic pipeline.

# SimFin — alternate fundamentals source; research-only, no live consumer.
SIMFIN_API_KEY=

# Quiver — alternate alt-data source; research-only, no live consumer.
QUIVER_API_KEY=

# iVolatility — options-implied retrospectives; subscription expired 2026-05-10,
# kept for cache replay only.
IVOLATILITY_API_KEY=

# runpod.io — CPU/GPU pod bootstrap for audits; used by the runpod CLI, not by
# any in-repo Python module.
RUNPOD_API_KEY=

