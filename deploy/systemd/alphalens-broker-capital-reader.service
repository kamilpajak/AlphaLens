[Unit]
# The EXPENSIVE half of the frame-vs-balance ratio (#1203): read the LIVE
# account balance and publish it as a Prometheus gauge.
#
# WHY A SEPARATE UNIT AND NOT THE DAEMON. `get_account()` is three HTTP
# requests, each retrying up to SaxoClient._MAX_REQUEST_ATTEMPTS times on
# _SERVER_ERROR_BACKOFFS behind the client timeout (4 / 5-15-30s / 30s today), so
# one read can block for minutes. `run_daemon` calls its
# protective tick BARE, so a blocking observability read inside the loop would
# stall reconcile, exit management and stop placement for exactly that long —
# and precisely during the broker outage that makes the read slow. Telemetry may
# observe the control path; it must not decide whether that path runs.
#
# The CHEAP half — the sizing pin actually in use — is published by the daemon
# itself, every tick, from a config read. That keeps the consistency guarantee
# (the frame reported is the frame in use, it cannot drift from a second config
# source) without putting its acquisition on the critical path. The two
# textfiles are joined in PromQL; node_exporter merges every *.prom in the dir.
#
#   cp deploy/systemd/alphalens-broker-capital-reader.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now alphalens-broker-capital-reader.timer
#
# READ-ONLY on LIVE by construction: `_cli_broker(mutating=False)` routes LIVE
# reads and refuses LIVE placement (#1052) — nothing here can place an order.
# That does NOT make the unit rail-free, and the first deploy of this unit
# failed on exactly that. `create_saxo_broker_live_from_env` runs
# `assert_live_rails()` BEFORE any broker I/O and refuses to construct a LIVE
# client at all until the risk rails are pinned inside the live-soak bounds, so
# a balance read pays the same boot surface as the daemon: the rails below, the
# SAXO_LIVE_* auth env from /etc/alphalens/env, and the account-bound ADR 0017
# grant (host-only drop-in, see the runbook).
#
# The rails ARE config that can drift, so this unit is watched by the hourly
# drift check like the daemons (UNITS in
# apps/alphalens-research/scripts/check_systemd_drift.py). Read the values as
# "what the assert demands", never as a statement about what the LIVE daemon
# runs — production overrides several of them via its own tracked drop-ins.
Description=AlphaLens LIVE account-balance gauge (frame-vs-balance ratio)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/AlphaLens

# SAXO_LIVE_* credentials. Fail loud on a missing env file.
EnvironmentFile=/etc/alphalens/env

Environment=ALPHALENS_BROKER_ENVIRONMENT=live

# The nine rails `assert_live_rails` demands before ANY LIVE client is built —
# see the header. None of them governs anything here: this unit never sizes,
# places or exits. They are copies of the base LIVE unit's conservative pins,
# so they are already-reviewed numbers rather than a second set invented here.
#
# ALLOW_ORDERS=0 is NOT one of the nine (the assert never reads it). It is here
# because a rails block with zero is this repo's canonical DISARMED shape — the
# base LIVE unit ships exactly that, and arming lives in its own separate
# drop-in. A reader is never armed.
#
# Do not "tighten" these to zeros: four of the bounds are lower-exclusive and
# two integer bounds start at 1, so an all-zero block fails the assert with six
# violations.
Environment=ALPHALENS_BROKER_ALLOW_ORDERS=0
Environment=ALPHALENS_BROKER_MAX_OPEN=1
Environment=ALPHALENS_BROKER_PORTFOLIO_GROSS_FRAC=0.25
Environment=ALPHALENS_BROKER_DAILY_LOSS_LIMIT_R=1.0
Environment=ALPHALENS_BROKER_SIZING_EQUITY=10000
Environment=ALPHALENS_BROKER_SIZING_EQUITY_MODE=declared
Environment=ALPHALENS_BROKER_EXIT_POLICY=breakeven_trail
Environment=ALPHALENS_BROKER_MAX_FEE_BPS=100
Environment=ALPHALENS_BROKER_ENTRY_TRAIL_BPS=0
Environment=ALPHALENS_BROKER_ENTRY_WATCH_MAX_PICKS=1

Environment=ALPHALENS_TEXTFILE_DIR=/var/lib/node_exporter/textfile

ExecStart=%h/AlphaLens/.venv/bin/alphalens broker capital-reader

# Cron-health metrics, wired like every other timer-driven unit. The generic
# AlphalensJobStale rule is deliberately NOT added on top: a failed read writes
# no gauge file on purpose, so AlphalensBrokerCapitalReadStale already pages on
# a dead reader — and on a STRICTLY better signal, the freshness of the READING
# itself, which also catches a run that exits 0 while producing nothing usable.
# The exemption is recorded in tests/test_prometheus_rule_unit_parity.py, the
# same shape edge-mirror already uses.
ExecStopPost=%h/AlphaLens/deploy/systemd/bin/alphalens-emit-job-metrics broker-capital-reader

StandardOutput=journal
StandardError=journal

MemoryMax=512M
TasksMax=16

[Install]
WantedBy=default.target
