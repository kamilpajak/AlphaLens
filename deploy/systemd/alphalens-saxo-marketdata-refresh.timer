[Unit]
Description=AlphaLens Saxo LIVE market-data OAuth keep-alive timer (20min wall-clock grid, inside the 40min window)

[Timer]
# 20min << 40min refresh-token life. WALL-CLOCK, NOT INTERVAL (#1208) — same
# rationale, phase arithmetic and verification rule as
# alphalens-saxo-refresh.timer (the SIM/order-chain twin): OnUnitActiveSec
# anchors to activation history and can leave the timer dormant with NEXT
# empty after a mid-uptime stop/start (#1206); OnCalendar schedules on start,
# and Persistent=true (only effective with OnCalendar) fires ONE coalesced
# boot catch-up when downtime spans a grid point.
#
# Sharing the :00/20 grid with the twin is deliberate — DISJOINT token
# stores (saxo_auth_live vs saxo_auth), nothing to phase-offset. This timer
# is only the keep-alive FLOOR for idle stretches; per-tick consumers adopt
# the rotation under the store flock.
#
# After enabling, verify the EFFECT: `systemctl --user list-timers` must
# show a populated NEXT — `is-active`/`is-enabled` are not evidence.
OnCalendar=*-*-* *:00/20:00 UTC
Persistent=true
Unit=alphalens-saxo-marketdata-refresh.service

[Install]
WantedBy=timers.target
