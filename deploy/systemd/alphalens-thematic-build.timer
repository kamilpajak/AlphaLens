[Unit]
# Fires the companion alphalens-thematic-build.service 3× per day, all
# before the NYSE open (#1479).
#
#   00:30 UTC  the deciding run: builds and publishes the brief for
#              yesterday (UTC). A published brief is final
#              (alphalens_pipeline/thematic/publication.py).
#   04:30 UTC  repair: publishes the date only if the 00:30 run failed,
#   08:30 UTC  and fills in options telemetry the earlier slot missed.
#
# Until #1479 the build ran 6× a day (00/04/08/12/16/20:30, PR-F #300).
# Since the idempotent freeze the 00:30 slot set the list on every date,
# and the later slots could only CHANGE it: 16 of 114 dates were
# recomputed after the open, so /edge measured lists the owner never read
# (docs/research/thematic_brief_publication_history_2026_09_16.md). The
# owner reads the brief around 07:00-08:00 UTC and before the open.
#
# HH:30 keeps the schedule readable in `systemctl --user list-timers` and
# out of the every-15-min EDGAR-detect fires.
#
# Persistent=true: if the VPS was off when a slot was due, fire the missed
# run once at next boot. A catch-up run after the arrival open publishes
# nothing for that date (the deadline), so a late boot cannot create a
# brief nobody read before trading.
Description=Trigger AlphaLens thematic build 3× daily (00:30, 04:30, 08:30 UTC)
After=network-online.target

[Timer]
OnCalendar=*-*-* 00,04,08:30:00 UTC
Persistent=true
# 5min jitter deflects the boot-storm thundering herd: a VPS that
# missed a day of slots fires the catch-up at boot+0, which collides with
# the every-15-min EDGAR-detect timer and the daily backfills the same
# boot rescues, all using the same SEC/Polygon per-IP buckets.
RandomizedDelaySec=5min
Unit=alphalens-thematic-build.service

[Install]
WantedBy=timers.target
