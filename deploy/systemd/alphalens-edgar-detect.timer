[Unit]
# Fires the companion alphalens-edgar-detect.service every 15 min on the
# wall clock, matching the Mac launchd StartInterval=900 cadence.
#
# Boot warmup: the old OnBootSec=2min buffer is gone WITHOUT a replacement
# ordering — `network-online.target` does not exist in the USER manager
# (LoadState=not-found, verified live 2026-08-31), so an After= on it was
# always a silent no-op. The SERVICE files carry the same After=/Wants=
# lines and they are equally inert there (follow-up cleanup, not this
# change). The real protection is absorb-next-fire: a boot
# catch-up poll that lands in a half-warm DNS window fails once and the
# next grid fire (<= 15 min) retries, well inside the 1800s
# AlphalensJobStale budget; the dedup store gates re-alerting.
#
# Persistent=true: if the VPS was off when a scheduled fire was due,
# trigger one catch-up run at boot. SEC EDGAR data is append-only and
# the dedup store gates re-alerting, so a catch-up fire just walks a
# slightly wider window without dispatching duplicate Telegrams.
Description=Trigger AlphaLens Layer 1 EDGAR detector every 15 minutes

[Timer]
# WALL-CLOCK, NOT INTERVAL (#1208, after the 2026-08-30 #1206 dormancy):
# OnUnitActiveSec anchors to a service activation observed WHILE THE TIMER
# RUNS, so a mid-uptime stop/start ordering can leave the timer
# `enabled` + `active` with NEXT empty, forever. OnCalendar schedules the
# moment the timer starts, independent of activation history, and is the
# only form under which Persistent=true has any effect (systemd.timer(5)).
# The exact 15-min grid is load-bearing: AlphalensJobStale pages at
# 1800s = 2x this cadence.
#
# After enabling, verify the EFFECT: `systemctl --user list-timers` must
# show a populated NEXT — `is-active`/`is-enabled` are not evidence.
OnCalendar=*-*-* *:00/15:00 UTC
Persistent=true
Unit=alphalens-edgar-detect.service

[Install]
WantedBy=timers.target
