[Unit]
# AlphaLens thematic pipeline — runs the daily news → brief refresh
# end-to-end via the pipeline image (built standalone from
# deploy/docker/Dockerfile.pipeline). The Django stack picks up the
# new parquet output via a one-shot `rebuild-cache` invocation in
# ExecStartPost.
#
# Install as a *user* unit alongside the companion timer:
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/systemd/alphalens-thematic-build.service ~/.config/systemd/user/
#   cp deploy/systemd/alphalens-thematic-build.timer   ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now alphalens-thematic-build.timer
#
# Inspect:           journalctl --user -u alphalens-thematic-build.service -f
# Trigger manually:  systemctl --user start alphalens-thematic-build.service
#
# Persistence (survives logout) — once, as the user:
#   sudo loginctl enable-linger "$USER"
Description=AlphaLens thematic build (daily)
After=network-online.target docker.service
Wants=network-online.target

# Shadow-arm collection (#1330) hangs off a SUCCESSFUL build, not a timer:
# it needs this run's map-themes funnel, and "after the build succeeded" is
# that ordering without clock arithmetic. The collector is idempotent per
# asof (draws once, skips in seconds on the other five slots), so a slot
# that fails simply leaves the draw to the next successful one. It used to
# run INSIDE run_thematic_day.sh between map-themes and score, where its
# 65-73 min put the 00:30 UTC slot past TimeoutStartSec on 12 of 13 days.
OnSuccess=alphalens-thematic-shadow-map.service

[Service]
Type=oneshot
WorkingDirectory=%h/AlphaLens

# Pipeline secrets live in /etc/alphalens/env (root:root chmod 600). systemd
# loads them into the unit's process env, and the explicit `-e KEY` flags
# below cherry-pick which ones cross into the container. No leading `-`:
# if the file is missing the unit MUST fail loud rather than limp on
# without secrets (Polygon skipped, LLM extract fails partway, partial
# parquet poisons cache). See deploy/systemd/README.md "Environment file
# setup" for the bootstrap recipe.
EnvironmentFile=/etc/alphalens/env

# Inherit operator UID/GID into the pipeline container so bind-mount writes
# land as the user, not root. The `-e KEY` form (no `=value`) tells docker
# to copy the value from the calling env — that's where systemd's
# EnvironmentFile vars live. Adding a new pipeline secret means: update
# /etc/alphalens/env on the host AND add a `-e NEW_KEY` line below.
#
# ALPHALENS_TEXTFILE_DIR is the one exception that carries an explicit
# `=value`: it is a non-secret infra path (the node_exporter textfile
# scrape dir), and the container's emit_domain_metrics must write the
# thematic stage gauges (#373/#374) + the VIX freshness gauge (#376) THERE,
# not into the `~/.alphalens` bind mount (which node_exporter does NOT
# scrape — live --collector.textfile.directory=/var/lib/node_exporter/
# textfile). The identity `-v` mount makes that container path the host's
# real scrape dir; the explicit value (vs bare `-e KEY`) keeps the routing
# correct even if /etc/alphalens/env never defines the var.
#
# The four ALPHALENS_OPENROUTER_* vars are not secrets but still use the
# bare `-e KEY` form: they are the operator's provider pin, and the LIVE
# pipeline wants different values from a REPLAY measurement run (the intended
# live shape sets ALPHALENS_OPENROUTER_QUANTIZATIONS=fp8 and leaves fallbacks
# ON so no single provider is a point of failure; a replay pins one provider
# with ALPHALENS_OPENROUTER_ALLOW_FALLBACKS=0 so a run served by a different
# backend fails instead of quietly becoming a worthless measurement). Keeping
# the values in /etc/alphalens/env means changing the pin is one file edit,
# not a unit reinstall. Nothing in the repo sets any of them; forwarding them
# only makes /etc/alphalens/env able to. All four unset = today's unpinned
# behaviour, byte for byte: docker forwards nothing and the client sends no
# `provider` block.
# Supervise the CONTAINER, not the docker client (#1330). systemd's
# TimeoutStartSec SIGTERM reaches only the client in this unit's cgroup;
# the client proxies it to the container's PID 1, which was bash — and a
# PID 1 with default signal disposition ignores SIGTERM — so nothing
# stopped: after TimeoutStopSec systemd SIGKILLed the client, the unit was
# marked failed, and the workload kept writing for 30+ min (2026-09-05:
# theme_shadow 04:39, buffett_qual 05:00, unit killed 04:27) while both
# ExecStartPost steps were skipped. Three pieces, each covering a path the
# others do not:
#   --init            tini as PID 1 forwards SIGTERM to bash. bash is no
#                     longer PID 1 and sets no trap, so it dies at once
#                     (it defers only TRAPPED signals while a foreground
#                     child runs); tini then exits, and with PID 1 gone the
#                     kernel SIGKILLs every process left in the container's
#                     PID namespace. The first SIGTERM now ends the run.
#   --name <unit>     a fixed name so the container can be addressed by
#                     the two docker rm lines below.
#   ExecStartPre rm   a stale named container (daemon restart, an orphan
#                     from before this fix) would make `docker run --name`
#                     refuse and fail the slot; `-` tolerates "no such
#                     container", the normal case after a clean `--rm` run.
#   ExecStopPost rm   the belt for the client-SIGKILLed-before-proxying
#                     path; runs on every stop including timeout, BEFORE
#                     the metrics hook.
ExecStartPre=-/usr/bin/docker rm -f alphalens-thematic-build
ExecStartPre=-/usr/bin/docker rm -f alphalens-thematic-experts-enrich
ExecStart=/usr/bin/env UID=%U GID=%G /usr/bin/docker run --rm \
    --init --name alphalens-thematic-build \
    --user %U:%G \
    -e HOME=/app/home \
    -e OPENROUTER_API_KEY \
    -e ALPHA_VANTAGE_API_KEY \
    -e POLYGON_API_KEY \
    -e PERPLEXITY_API_KEY \
    -e TELEGRAM_BOT_TOKEN \
    -e TELEGRAM_CHAT_ID \
    -e SEC_EDGAR_USER_AGENT \
    -e FRED_API_KEY \
    -e ALPHALENS_OPENROUTER_PROVIDER_ORDER \
    -e ALPHALENS_OPENROUTER_ALLOW_FALLBACKS \
    -e ALPHALENS_OPENROUTER_QUANTIZATIONS \
    -e ALPHALENS_OPENROUTER_REQUIRE_PARAMETERS \
    -e ALPHALENS_TEXTFILE_DIR=/var/lib/node_exporter/textfile \
    -e ALPHALENS_CANONICAL_TITLE=1 \
    -e ALPHALENS_PERPLEXITY_SOURCE=1 \
    -e ALPHALENS_EVENT_LANE \
    -v %h/.alphalens:/app/home/.alphalens \
    -v /var/lib/node_exporter/textfile:/var/lib/node_exporter/textfile \
    --entrypoint /bin/bash \
    alphalens-pipeline:latest \
    /app/deploy/docker/run_thematic_day.sh

# Gap-detection on the news_ingest cache (PR-E, epic #295 Risk A).
# Fires after the pipeline ExecStart succeeds but BEFORE the Django
# rebuild-cache — so a corrupt or missing parquet halts the chain
# rather than silently refreshing Django from incomplete data.
# Telegram alert on the missing-day digest is opt-in via --alert and
# reads TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID from the inherited env.
# Window of 7 days covers a clean operational week + the most-recent
# rebuild window without overshooting catalyst_resolver's 30-day
# lookback (manual --days 30 invocation available for deep audits).
# Runs in the same pipeline image so the alphalens CLI is on PATH; the
# bind mount keeps it inspecting the host cache rather than the
# container's local copy.
#
# **No leading `alphalens` arg.** The pipeline image's ENTRYPOINT is
# `/app/.venv/bin/alphalens` (Dockerfile.pipeline line 84), so the
# tokens after the image name are forwarded as CLI args. Including a
# literal `alphalens` here would make Typer parse it as the first
# subcommand and abort with `No such command 'alphalens'` — observed
# on VPS 2026-05-29 after PR-E rolled out the original wording. Fix:
# args start at `thematic`. The same rule applies to any future
# ExecStartPost using the pipeline image — entrypoint-aware.
ExecStartPost=/usr/bin/docker run --rm \
    --user %U:%G \
    -e HOME=/app/home \
    -e TELEGRAM_BOT_TOKEN \
    -e TELEGRAM_CHAT_ID \
    -v %h/.alphalens:/app/home/.alphalens \
    alphalens-pipeline:latest \
    thematic verify-cache --days 7 --alert

# Sync the parquet output the pipeline just wrote into the Django Postgres
# cache via the maintenance one-shot. ``--profile maintenance`` opt-in
# isolates this from the always-on ``django`` service. ExecStartPost fires
# only on ExecStart success AND the preceding verify-cache exit-0; a
# pipeline failure OR a gap-detect alert leaves the cache untouched so
# the operator can investigate before partial data hits Django.
ExecStartPost=/usr/bin/docker compose \
    -f %h/AlphaLens/deploy/docker/django-prod/docker-compose.yaml \
    --profile maintenance run --rm rebuild-cache

# ---- everything below here is OPTIONAL, and that is the whole point --------
#
# The expert-panel qualitative layer used to live at the END of the ExecStart
# script. TimeoutStartSec covers the whole of ExecStart, so a timeout in this
# optional work killed the unit, systemd skipped EVERY ExecStartPost, and a
# brief already written to disk never reached Postgres. That happened on
# 2026-09-30 and was repaired by hand.
#
# Moving it here buys NO TIME. ExecStart and every ExecStartPost share one
# TimeoutStartSec, so the budget is exactly what it was. It buys ORDERING: the
# brief is in the database by the time this starts, so the same timeout now
# costs the Buffett drawer instead of the day's product.
#
# Both steps are `-`-prefixed. A DeepSeek or Perplexity hiccup must not mark
# the run failed, page the operator, or skip the rebuild below it.
#
# WHAT THE `-` DOES NOT COVER, so the operator is not surprised: it makes a
# non-zero EXIT non-fatal. A TimeoutStartSec kill is not an exit — it still
# marks the unit failed, still reaches the metrics hook below, and still pages,
# and it skips whatever ExecStartPost had not run yet, including the second
# rebuild-cache. So a timeout landing here costs the Buffett drawer AND an
# alert; what it no longer costs is the brief. Removing the alert too would
# mean a separate unit with its own timeout (an `OnSuccess=` sibling, the shape
# alphalens-thematic-shadow-map already uses) — more moving parts than the
# ordering fix, and worth revisiting only if these timeouts become routine.
#
# Supervised like the build container (#1330): `--init` so the first SIGTERM
# ends the run rather than only the docker client, a `--name` to address it by,
# and a `docker rm -f` on both ends.
#
# The env set is the MEASURED closure of what these two stages read, not a copy
# of ExecStart's: OpenRouter for the classifier, Perplexity for the scuttlebutt
# context, SEC for the 10-K fetch, and the four OpenRouter provider pins.
# Deliberately absent and checked rather than assumed: TELEGRAM_*, POLYGON,
# FRED and ALPHA_VANTAGE are unreachable from here; ALPHALENS_PERPLEXITY_SOURCE
# is read only by `news_ingest`, i.e. the `ingest` stage; and nothing on this
# path writes a Prometheus textfile metric, which is why the node_exporter mount
# and ALPHALENS_TEXTFILE_DIR are not here either. SEC_RATE_COORD_PATH needs no
# passing: it defaults inside ~/.alphalens, so this container shares the same
# inode as the build one and the 10 req/s reservation still coordinates.
ExecStartPost=-/usr/bin/docker run --rm \
    --init --name alphalens-thematic-experts-enrich \
    --user %U:%G \
    -e HOME=/app/home \
    -e OPENROUTER_API_KEY \
    -e PERPLEXITY_API_KEY \
    -e SEC_EDGAR_USER_AGENT \
    -e ALPHALENS_OPENROUTER_PROVIDER_ORDER \
    -e ALPHALENS_OPENROUTER_ALLOW_FALLBACKS \
    -e ALPHALENS_OPENROUTER_QUANTIZATIONS \
    -e ALPHALENS_OPENROUTER_REQUIRE_PARAMETERS \
    -v %h/.alphalens:/app/home/.alphalens \
    --entrypoint /bin/bash \
    alphalens-pipeline:latest \
    /app/deploy/docker/run_experts_enrich.sh

# `experts enrich` stamps its columns INTO the brief parquet the brief stage
# wrote, so without a second pass they stay on disk until the next slot.
# rebuild-cache is mtime-gated per date and idempotent, so this re-publishes
# only the date that just changed. Best-effort: the brief itself is already
# published, and failing here must not undo that.
ExecStartPost=-/usr/bin/docker compose \
    -f %h/AlphaLens/deploy/docker/django-prod/docker-compose.yaml \
    --profile maintenance run --rm rebuild-cache

# NOTE: the population-ladder edge mirror (``rebuild-ladder-outcomes``) used to
# live here too, but it was MOVED to alphalens-feedback-shadow-returns.service
# (ExecStartPost). That nightly job is the SOLE writer of the population-ladder
# parquet; mirroring it from thematic-build re-synced unchanged data 5× per day
# AND left the edge dashboard up to one slot (~2h) behind the recompute — the
# recompute lands at 06:30 UTC, after the morning thematic-build slot, so the
# mirror waited for the next slot. The briefs cache (``rebuild-cache`` above)
# stays here because the thematic pipeline IS its writer.

# Prometheus textfile metrics (see alphalens-edgar-detect.service for
# the pattern). Runs unconditionally so a failed pipeline run or
# verify-cache halt also updates the exit code gauge — Alertmanager
# (PR-3) then fires on the non-zero exit.
ExecStopPost=-/usr/bin/docker rm -f alphalens-thematic-build
ExecStopPost=-/usr/bin/docker rm -f alphalens-thematic-experts-enrich
ExecStopPost=%h/AlphaLens/deploy/systemd/bin/alphalens-emit-job-metrics thematic-build

# Keep stdout/stderr in journald.
StandardOutput=journal
StandardError=journal

# Pipeline runs Polygon news (~few MB JSON), OpenRouter LLM calls (network-bound),
# and pandas/parquet I/O. 4G is comfortable headroom on a small VPS; bump if
# the SP500-scale insider gate trips OOM.
MemoryMax=4G
TasksMax=512

# Type=oneshot defaults TimeoutStartSec to infinity (man systemd.service
# §"Type=oneshot"). Without an explicit timeout, a run that wedges on a
# OpenRouter quota loop, a Polygon retry storm, or a stuck rebuild-cache step
# would block every subsequent timer fire forever — systemd queues new
# fires behind the running unit. 75min = ~4× the typical 15-20min wall
# time; a healthy run never trips this, a wedged one gets SIGTERM (then
# SIGKILL after TimeoutStopSec) so the next 4h slot can fire. Pinned by
# PR-F zen pre-merge review (epic #295 / issue #300).
#
# Bumped 45→75min on 2026-06-15: the pipeline grew (O'Neil R grouped-daily
# reads + eager Buffett qual enrich + scuttlebutt Perplexity), and a
# yfinance DNS-resolution storm (hundreds of `curl (28) Resolving timed
# out` errors) pushed two morning slots past 45min mid-`experts enrich`.
# Both were SIGKILLed before the rebuild-cache publish, so the brief that
# had already been written to parquet never reached Postgres and the
# dashboard sat a day behind. 75min stays well under the 4h slot spacing,
# so a truly wedged run is still killed before the next fire.
#
# Bumped 75→110min on 2026-08-19 for the stage-B channel assessment: map-themes
# now adds up to _MAX_ASSESS_PER_THEME (5) × _ASSESS_VOTES (3) OpenRouter calls
# per theme, each bounded above only by the client's read timeout. The stage
# fans out 3-wide per theme and is capped per theme, so the expected cost is
# minutes, but the worst case is materially larger than before — and map_themes
# writes its candidates parquet ONCE, after the whole theme loop, so a SIGTERM
# mid-stage leaves NO parquet at all: under `set -euo pipefail` the score and
# brief stages never run and the slot produces no brief. The next slot then
# restarts from zero and can fail the same way, which is a permanent stall
# rather than one missed slot. 110min still leaves ~2h of slot spacing.
#
# Bumped 110→150min on 2026-09-07 (#1330). The shadow-map collection left
# this unit (see OnSuccess= above), but the 14-day journal read that
# motivated the split showed the PRODUCT stages alone (ingest → map-themes,
# then score → vix) reaching 100 min on a heavy map-themes day (2026-08-26;
# 91 min on 08-24, 83 on 08-27, 81 on 08-25 — the stage-B channel
# assessment is the variable part), and on a Type=oneshot the two
# ExecStartPost steps count toward TimeoutStartSec too. 110 would have left
# such a day on the edge; 150 is 1.4× the observed max and still leaves 90
# min of the 4h slot spacing. With --init above, a timeout now actually
# stops the container, so a wedged run no longer survives its own verdict.
#
# Bumped 150->210min on 2026-09-30, after the FIRST scheduled deciding run on
# the #1606 schedule hit the cap. It started 04:30:21 UTC, wrote the brief
# parquet at 06:54:19, and was SIGTERMed at 07:00:21 (exit 143, Result=timeout)
# during `experts enrich`. Because the kill landed inside ExecStart, BOTH
# ExecStartPost steps were skipped: the brief existed on disk and never reached
# Postgres, so the dashboard showed nothing for the date until an operator ran
# rebuild-cache by hand. This is the same shape as the 2026-06-15 bump, one
# stage later.
#
# Measured stages of that run: ingest 9.6, extract 43.9, map-themes 29.7,
# score 43.3, brief 17.3 — 144 min to the end of `brief`, against a ~76 min
# mean over the 22 post-#1330 runs of the old 00:30 slot.
#
# Be precise about what is MEASURED here. 144 min to the end of `brief` is a
# measurement. The end-to-end figure is not: the unit was killed at 150 min with
# `experts enrich` still running, so nobody observed it finish. Adding the
# enrich tail's own historical cost gives an ESTIMATE of about 153 min, and that
# estimate is what 210 is sized against.
#
# The attributed cause is also one day's evidence, not a controlled comparison:
# the deciding run can now see ~97 EX-99.1 filings it used to get zero of, and
# news_ingest.DEFAULT_MAX_ITEMS caps the item COUNT at 200, not the token volume
# — an issuer press release is a long narrative where a GDELT row is a headline.
#
# CORRECTION, measured 2026-09-30. This block first said `score` had "tripled
# from 15.6 to 43.3 min" and called that unexplained. It had not. 15.6 was a
# MEAN over a series that swings from 2.8 to 50.5 min per run; the 04:30 slot of
# 2026-09-25 took 50.5, MORE than the run this bump responds to. Comparing one
# observation against a mean of a long-tailed series manufactured an anomaly
# that is not there, and no stage needs its own investigation.
#
# What IS true, over the 33 deciding runs since 2026-08-20, measured start to
# the end of `brief`: median 68.5 min, p90 112.5, previous max 118.2 on
# 2026-09-26. The 144 min run is the new max, 22% above the previous one, and it
# continues an upward drift already visible before the schedule moved (104 on
# 08-21, 110 on 09-07, 112 on 09-23, 118 on 09-26, 117 on 09-29). So 150min had
# only 32 min of headroom over the observed max BEFORE #1606 and was going to be
# hit regardless; the schedule change brought the collision forward rather than
# creating it. How much of the 26 min above the previous max is the EDGAR corpus
# is not separable from one day: the consecutive 09-29 (no EDGAR, 116.8) and
# 09-30 (EDGAR, 144.0) differ by less than this series' own day-to-day swing.
#
# WHY 210 AND NOT MORE. The timer's slots are 4h apart, RandomizedDelaySec=5min
# can eat 5 of that, and after the SIGTERM systemd still needs TimeoutStopSec
# plus both ExecStopPost commands before the unit is inactive. Budgeting 10 min
# for that stop path leaves 225 min usable, so 210 is the estimate plus 37 min
# with 15 min still in hand. `test_the_repair_slots_are_spaced_far_enough_apart_to_not_queue`
# derives all of this from these two files and refuses anything from 225 up.
#
# It is NOT headroom to grow into: a run that genuinely needs 210 min finishes
# at 08:00 UTC, at the far edge of the 07:00-08:00 UTC window in which the owner
# reads the brief. If the product stages keep growing, the answer is to make them
# cheaper or to move work out of this unit, not to raise this number again.
#
# UPDATE (#1650). The coupling this comment used to call unfixed is fixed: the
# expert enrichment left the ExecStart shell and now runs after both publish
# steps, `-`-prefixed. Every ExecStartPost still counts toward this timeout, so
# the budget is unchanged and a long run can still be killed — but what it costs
# changed. Before, a timeout anywhere skipped the publish chain and lost a brief
# that was already on disk. Now the brief is in Postgres before the optional work
# starts, and the same timeout costs the Buffett qualitative drawer.
#
# What remains: a run slow enough to be killed DURING verify-cache or the first
# rebuild-cache still loses the publish. Measured over the three deciding runs
# since the 04:30 move, those two steps take 1-2 min against a 210 min budget,
# against 6-30 min for the enrichment they now sit in front of.
TimeoutStartSec=210min

# Oneshot doesn't auto-restart on success. On real failures (Polygon 5xx,
# OpenRouter quota, OOM) systemd surfaces non-zero exit in journalctl + status.
# The timer fires at 04:30, 08:30 and 12:30 UTC (#1479, moved 4h later by
# #1606 so the deciding run can see the SEC daily index); a failed 04:30 run
# is repaired by the next slot, which publishes the date if the brief is
# missing.

[Install]
WantedBy=default.target
